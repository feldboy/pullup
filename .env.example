# Environment Configuration Template
# Copy this to .env and fill in your values
# Environments: dev, preprod, prod

# ===========================================
# ENVIRONMENT
# ===========================================
ENVIRONMENT=dev  # dev, preprod, prod

# ===========================================
# LLM PROVIDERS
# ===========================================
# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# OpenRouter (for accessing multiple models) - Free tier available
OPENROUTER_API_KEY=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

# Default LLM provider: openai, gemini, openrouter
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_MODEL=xiaomi/mimo-v2-flash

# ===========================================
# DATABASE (Supabase)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Direct PostgreSQL connection (for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ===========================================
# TELEGRAM BOT
# ===========================================
TELEGRAM_BOT_TOKEN=8490932438:AAFVy70Urq5Cj0h7gUKJbECBv3z9-apYZtM

# ===========================================
# WHATSAPP (Phase 2+)
# ===========================================
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# ===========================================
# SECURITY
# ===========================================
JWT_SECRET_KEY=your-jwt-secret-change-in-production
WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# MONITORING (Optional)
# ===========================================
LOGFIRE_TOKEN=
# SENTRY_DSN=

# ===========================================
# APPLICATION
# ===========================================
APP_NAME=EloozFit AI Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Rate limiting
MAX_MESSAGES_PER_HOUR=10
MAX_UNANSWERED_MESSAGES=2
FOLLOWUP_WAIT_HOURS=48
